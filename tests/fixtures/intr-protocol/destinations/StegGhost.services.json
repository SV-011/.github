{
  "schema_version": "stegghost.service-registry.v1",
  "organization": "StegGhost",
  "services": [
    {
      "service_id": "stegghost.org-control",
      "repository": "StegGhost/.github",
      "boundary_role": "BOUNDARY_LOCAL_CONTROL",
      "profile_status": "ACTIVE",
      "accepts": [
        "ecosystem.communication",
        "ecosystem.monitor.request",
        "ecosystem.work.request"
      ],
      "runtime_required_for_consumption": false
    },
    {
      "service_id": "stegghost.boundary-diagnostic",
      "repository": "StegGhost/.github",
      "boundary_role": "BOUNDARY_LOCAL_DIAGNOSTIC",
      "profile_status": "ACTIVE",
      "runtime_required_for_consumption": false
    },
    {
      "service_id": "stegghost.intr-destination",
      "repository": "StegGhost/.github",
      "boundary_role": "BOUNDARY_LOCAL_CAPABILITY_INGRESS",
      "profile_status": "ACTIVE",
      "capability_profile_id": "intr-destination",
      "capability_binding_document": "org-runtime/interlock-intr.json",
      "accepts": [
        "ecosystem.communication",
        "stegverse.org-intr-destination-diagnostic/v1"
      ],
      "runtime_required_for_consumption": true,
      "admission_authority_constraint": "CONSTRAINT_VARIABLE",
      "time_constraint": "CONSTRAINT_VARIABLE",
      "disposition_role": "TRANSITION_EVIDENCE_ONLY",
      "selects_processing_at_this_address": false
    },
    {
      "service_id": "stegghost.entity-sandbox-runner",
      "repository": "StegGhost/entity-sandbox-runner",
      "boundary_role": "INTERNAL_ENDPOINT",
      "profile_status": "NEEDS_REPOSITORY_HANDOFF_RECONCILIATION",
      "runtime_required_for_consumption": true
    },
    {
      "service_id": "stegghost.telemetry",
      "repository": "StegGhost/telemetry",
      "boundary_role": "INTERNAL_ENDPOINT",
      "profile_status": "NEEDS_REPOSITORY_HANDOFF_RECONCILIATION",
      "runtime_required_for_consumption": true
    },
    {
      "service_id": "stegghost.automated-buildout",
      "repository": "StegGhost/automated_buildout",
      "boundary_role": "INTERNAL_ENDPOINT",
      "profile_status": "NEEDS_REPOSITORY_HANDOFF_RECONCILIATION",
      "runtime_required_for_consumption": true
    },
    {
      "service_id": "stegghost.stegverse-sandbox",
      "repository": "StegGhost/stegverse-sandbox",
      "boundary_role": "INTERNAL_ENDPOINT",
      "profile_status": "NEEDS_REPOSITORY_HANDOFF_RECONCILIATION",
      "runtime_required_for_consumption": true
    },
    {
      "service_id": "stegghost.stegcge",
      "repository": "StegGhost/StegCGE",
      "boundary_role": "INTERNAL_ENDPOINT",
      "profile_status": "NEEDS_REPOSITORY_HANDOFF_RECONCILIATION",
      "runtime_required_for_consumption": true
    },
    {
      "service_id": "stegghost.ghost-pat-lab",
      "repository": "StegGhost/ghost-pat-lab",
      "boundary_role": "INTERNAL_ENDPOINT",
      "profile_status": "NEEDS_REPOSITORY_HANDOFF_RECONCILIATION",
      "runtime_required_for_consumption": true
    }
  ],
  "boundary_rule": "Cross-organization ingress/egress semantics are defined by the organization boundary; endpoint authority remains transition-governed."
}
